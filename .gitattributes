# Normalize line endings. This repo is built on Linux / WSL2; shell scripts
# and sources must stay LF regardless of a contributor's core.autocrlf.
* text=auto eol=lf

*.sh    text eol=lf
*.S     text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.ld    text eol=lf
Makefile text eol=lf
*.mk    text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

*.bin   binary
*.elf   binary
*.hex   binary
